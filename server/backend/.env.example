# Copy to .env (or export these) before starting the backend.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=labora.yourcollege.edu,localhost
CORS_ALLOWED_ORIGINS=https://labora.yourcollege.edu
TIME_ZONE=Asia/Kolkata

# PostgreSQL (leave POSTGRES_DB empty to use SQLite for local development)
POSTGRES_DB=labora
POSTGRES_USER=labora
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Code execution: judge0 (production) or local (DEVELOPMENT ONLY, no sandbox)
CODE_EXECUTOR=judge0
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
# For RapidAPI-hosted Judge0 set the host as well, e.g. judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=
JUDGE0_LANG_C=50
JUDGE0_LANG_JAVA=62
JUDGE0_LANG_PYTHON=71
EXECUTION_TIMEOUT_SECONDS=5
RUN_RATE=20/min

# Must match "browserKey" in desktop/labora.config.json of the secure browser build
LABORA_SECURE_BROWSER_KEY=change-this-shared-browser-key
LABORA_SECURE_BROWSER_MAX_SKEW=300

# Optional teacher-side AI summary (OpenAI-compatible API). Leave empty to disable.
# Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.0-flash
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Review indicator thresholds
INDICATOR_LARGE_INSERT_CHARS=120
INDICATOR_LATE_CHANGE_MINUTES=2
INDICATOR_LATE_CHANGE_RATIO=0.5
