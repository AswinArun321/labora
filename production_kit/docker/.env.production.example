# ==============================================================================
# LABORA Institutional Production Environment Configuration
# Copy this file to .env before starting the production Docker Compose stack:
#   cp .env.production.example .env
#
# Generate cryptographically secure random secrets before deployment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. College Domain & Network Routing
# ------------------------------------------------------------------------------
# Fully Qualified Domain Name (FQDN) or College Intranet IP/Hostname
DOMAIN_NAME=labora.college.edu

# Django Allowed Hosts (comma-separated, without scheme)
DJANGO_ALLOWED_HOSTS=labora.college.edu,localhost,127.0.0.1,backend

# Allowed CORS origins for the frontend application (include scheme & port if non-standard)
CORS_ALLOWED_ORIGINS=https://labora.college.edu

# ------------------------------------------------------------------------------
# 2. Django Security & Application Secrets
# ------------------------------------------------------------------------------
# MUST BE UNIQUE AND SECRET IN PRODUCTION (64+ random characters)
DJANGO_SECRET_KEY=GENERATE_NEW_RANDOM_SECRET_KEY_HERE_MINIMUM_50_CHARS

# Debug MUST be false in production environments
DJANGO_DEBUG=false

# Timezone (e.g. Asia/Kolkata, UTC)
TIME_ZONE=Asia/Kolkata

# SSL / TLS Settings (Django terminates TLS via Nginx reverse proxy)
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
ENABLE_HSTS=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=labora
POSTGRES_USER=labora_admin
# Strong alphanumeric password for production database user
POSTGRES_PASSWORD=GENERATE_STRONG_DB_PASSWORD_HERE
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. Redis Task Queue Broker & Shared Cache
# ------------------------------------------------------------------------------
# Strong authentication password for Redis instance
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_HERE

# Redis connection URLs (Broker: DB 0, Result Backend: DB 1, Shared Cache: DB 2)
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1
REDIS_CACHE_URL=redis://:${REDIS_PASSWORD}@redis:6379/2
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ------------------------------------------------------------------------------
# 5. Judge0 Isolated Sandbox Execution Engine
# ------------------------------------------------------------------------------
CODE_EXECUTOR=judge0
JUDGE0_URL=http://judge0-server:2358
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=

# Judge0 Language IDs (Default standard mappings)
JUDGE0_LANG_C=50
JUDGE0_LANG_JAVA=62
JUDGE0_LANG_PYTHON=71

# Execution Timeouts and Dispatch Parameters
EXECUTION_TIMEOUT_SECONDS=5.0
EXECUTION_POLL_TIMEOUT_SECONDS=30
EXECUTION_POLL_INITIAL_INTERVAL_SECONDS=0.5
EXECUTION_POLL_MAX_INTERVAL_SECONDS=2.0
JUDGE0_DISPATCH_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 6. Celery Task Queue Worker Settings
# ------------------------------------------------------------------------------
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT=120
CELERY_TASK_SOFT_TIME_LIMIT=90

# ------------------------------------------------------------------------------
# 7. Document & Lab Record Generation
# ------------------------------------------------------------------------------
# "auto" selects LibreOffice headless if available, falling back to WeasyPrint
DOCX_PDF_CONVERTER=auto
LIBREOFFICE_PATH=soffice
RECORD_GENERATION_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 8. LABORA Secure Browser Key & Anti-Cheating
# ------------------------------------------------------------------------------
# Shared HMAC secret baked into client-side Electron Secure Browser build
LABORA_SECURE_BROWSER_KEY=GENERATE_STRONG_BROWSER_HMAC_KEY_HERE
LABORA_SECURE_BROWSER_MAX_SKEW=300

# ------------------------------------------------------------------------------
# 9. API Security & Throttling
# ------------------------------------------------------------------------------
LOGIN_RATE=20/min
REFRESH_RATE=30/min
RUN_RATE=20/min
USER_RATE=600/min

# JWT Lifetime Settings
JWT_ACCESS_MINUTES=60
JWT_REFRESH_HOURS=12

# File Upload Constraints (bytes, default 5MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

# ------------------------------------------------------------------------------
# 10. Optional Teacher-Side AI Code Review (Disabled by default)
# ------------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Review indicator thresholds
INDICATOR_LARGE_INSERT_CHARS=120
INDICATOR_LATE_CHANGE_MINUTES=2
INDICATOR_LATE_CHANGE_RATIO=0.5
