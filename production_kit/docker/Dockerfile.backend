# LABORA Production Backend & Celery Dockerfile
# Based on Python 3.11 slim with full WeasyPrint PDF, LibreOffice headless, and Gunicorn support
FROM python:3.11-slim

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies:
# - PostgreSQL client libraries
# - WeasyPrint rendering libraries (Pango, Cairo, GdkPixbuf)
# - LibreOffice headless for dual-engine DOCX to PDF conversion
# - Indic and Unicode fonts for multi-language lab record printing
# - Utility tools (curl, netcat-openbsd)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    curl \
    netcat-openbsd \
    libreoffice-writer \
    default-jre-headless \
    fonts-dejavu-core \
    fonts-noto-core \
    fonts-indic \
    fonts-freefont-ttf \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt /app/
RUN pip install --no-cache-dir -U pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY . /app/

# Copy entrypoint script and set permissions
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh || true

# Create non-privileged user and setup directories
RUN useradd -u 1000 -m labora && \
    mkdir -p /app/media /app/staticfiles && \
    chown -R labora:labora /app

USER labora

EXPOSE 8000

ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Default command: run Gunicorn with 4 workers and sync worker type
CMD ["gunicorn", "labora.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "4", "--timeout", "60", "--access-logfile", "-", "--error-logfile", "-"]
