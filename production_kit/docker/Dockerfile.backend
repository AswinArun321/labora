# LABORA Production Backend & Celery Dockerfile
# Based on Python 3.11 slim with full WeasyPrint PDF and Gunicorn support
FROM python:3.11-slim

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies for PostgreSQL, WeasyPrint (Pango, Cairo, GdkPixbuf), and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt /app/
RUN pip install --no-cache-dir -U pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY . /app/

# Create non-privileged user and setup directories
RUN useradd -u 1000 -m labora && \
    mkdir -p /app/media /app/staticfiles && \
    chown -R labora:labora /app

USER labora

EXPOSE 8000

# Default command: run Gunicorn with 4 workers and gevent/sync worker type
CMD ["gunicorn", "labora.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "4", "--timeout", "60", "--access-logfile", "-", "--error-logfile", "-"]
